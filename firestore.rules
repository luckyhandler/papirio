rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{scoreId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'territory', 'kills', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.territory is number
        && request.resource.data.territory >= 0
        && request.resource.data.territory <= 100
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 999
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }
  }
}
